{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML -}}
{{- $pages := .RegularPagesRecursive -}}
{{- if .IsHome }}{{ $pages = partial "ash/posts.html" .Site }}{{ end -}}
{{- $pages = where (where $pages "Params.hidden" "ne" true) "Params.noindex" "ne" true -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 0 }}{{ $pages = first $limit $pages }}{{ end -}}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>{{ .Title }}{{ if not .IsHome }} · {{ .Site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Description | default .Site.Params.description | default .Site.Title }}</description>
    <language>{{ (partial "ash/language.html" .Language).locale }}</language>
    {{ with .OutputFormats.Get "RSS" }}<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>{{ end }}
    {{ range $pages.ByDate.Reverse }}
    <item>
      <title>{{ .Title }}</title><link>{{ .Permalink }}</link><guid isPermaLink="true">{{ .Permalink }}</guid>
      {{ if not .Date.IsZero }}<pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>{{ end }}
      <dc:creator>{{ partial "ash/author.html" . }}</dc:creator>
      {{ range .GetTerms "categories" }}<category>{{ .LinkTitle }}</category>{{ end }}
      {{ $body := .Summary }}{{ if .Site.Params.rssFullContent }}{{ $body = .Content }}{{ end }}
      {{ $base := urls.Parse .Site.BaseURL }}
      {{ $body = replaceRE `(href|src)="(/[^\"]*)"` (printf `${1}="%s://%s${2}"` $base.Scheme $base.Host) $body }}
      <description>{{ $body | html }}</description>
    </item>
    {{ end }}
  </channel>
</rss>
